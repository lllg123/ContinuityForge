{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lllg123/ContinuityForge/blob/main/docs/schema/rcpsp-problem-v2.schema.json",
  "title": "ContinuityForge single-mode RCPSP problem v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "time_unit", "resources", "tasks", "dependencies"],
  "properties": {
    "schema_version": { "const": "continuityforge.rcpsp.v2" },
    "time_unit": { "type": "string", "minLength": 1 },
    "resources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "capacity"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "duration", "priority", "demands", "release_time"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "duration": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
          "priority": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
          "demands": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["resource_id", "amount"],
              "properties": {
                "resource_id": { "type": "string", "minLength": 1 },
                "amount": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
              }
            }
          },
          "release_time": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
          "deadline": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "prerequisite_id"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "prerequisite_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "target_makespan": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
  },
  "$comment": "Uniqueness, acyclicity, demand/capacity, milestone and time-overflow constraints are enforced by the MoonBit validator."
}
