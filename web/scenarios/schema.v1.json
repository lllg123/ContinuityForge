{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lllg123/ContinuityForge/blob/main/web/scenarios/schema.v1.json",
  "title": "ContinuityForge scheduling scenario v1",
  "type": "object",
  "required": ["schemaVersion", "tasks", "targetWindow", "searchBudget"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string" },
    "dataKind": { "enum": ["synthetic", "public", "production"] },
    "timeUnit": { "type": "string", "minLength": 1 },
    "targetWindow": { "type": "integer", "minimum": 0 },
    "searchBudget": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "failedTaskId": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "duration", "resource", "priority", "dependsOn"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "assetType": { "enum": ["Service", "Component"] },
          "duration": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "resource": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
